{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://develop4god/schemas/youth-lesson.schema.json",
  "title": "YouthLessonDocument",
  "description": "Documento maestro para una unidad + lección de material bíblico para grupos de jóvenes (formato alumno/maestro).",
  "type": "object",
  "required": ["unit", "lesson"],
  "additionalProperties": false,
  "properties": {
    "unit": { "$ref": "#/definitions/unit" },
    "lesson": { "$ref": "#/definitions/lesson" }
  },
  "definitions": {
    "unit": {
      "type": "object",
      "required": ["id", "title", "age_range", "period", "lessons"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^unit_[a-z0-9_]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "age_range": { "type": "string", "pattern": "^[0-9]{1,2}-[0-9]{1,2}$" },
        "period": { "type": "string", "minLength": 3 },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^lesson_[a-z0-9_]+$" }
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id", "unit_id", "title", "objective",
        "shared", "student_content", "teacher_content", "metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^lesson_[a-z0-9_]+$" },
        "unit_id": { "type": "string", "pattern": "^unit_[a-z0-9_]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "objective": { "type": "string", "minLength": 10 },
        "shared": { "$ref": "#/definitions/shared" },
        "student_content": { "$ref": "#/definitions/student_content" },
        "teacher_content": { "$ref": "#/definitions/teacher_content" },
        "metadata": { "$ref": "#/definitions/metadata" }
      }
    },
    "shared": {
      "type": "object",
      "required": ["bible_reading", "key_verse", "hook"],
      "additionalProperties": false,
      "properties": {
        "bible_reading": {
          "type": "object",
          "required": ["reference", "version"],
          "additionalProperties": false,
          "properties": {
            "reference": { "type": "string", "minLength": 3 },
            "version": { "type": "string", "minLength": 2 },
            "context_note": { "type": "string" }
          }
        },
        "key_verse": {
          "type": "object",
          "required": ["reference", "text"],
          "additionalProperties": false,
          "properties": {
            "reference": { "type": "string", "minLength": 3 },
            "text": { "type": "string", "minLength": 5 }
          }
        },
        "hook": {
          "type": "object",
          "required": ["type", "content"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["testimonio", "historia_real", "pregunta_provocadora", "anecdota"]
            },
            "content": { "type": "string", "minLength": 10 }
          }
        }
      }
    },
    "student_content": {
      "type": "object",
      "required": [
        "audience", "teaching_summary", "comprehension_questions",
        "personal_outline", "family_discussion", "evangelism_prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "audience": { "const": "alumno" },
        "teaching_summary": { "type": "string", "minLength": 20 },
        "comprehension_questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text", "type"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string", "minLength": 5 },
              "type": { "type": "string", "enum": ["recall", "reflection"] }
            }
          }
        },
        "fill_in_blanks": {
          "type": "array",
          "items": { "type": "string", "minLength": 5 }
        },
        "personal_outline": {
          "type": "object",
          "required": ["points"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "points": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 5 }
            }
          }
        },
        "family_discussion": {
          "type": "object",
          "required": ["questions"],
          "additionalProperties": false,
          "properties": {
            "questions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 5 }
            }
          }
        },
        "evangelism_prompt": { "type": "string", "minLength": 10 }
      }
    },
    "teacher_content": {
      "type": "object",
      "required": [
        "audience", "teaching_deep_dive", "facilitation_notes",
        "group_dynamics", "leader_training", "materials_needed"
      ],
      "additionalProperties": false,
      "properties": {
        "audience": { "const": "maestro" },
        "teaching_deep_dive": { "type": "string", "minLength": 20 },
        "facilitation_notes": { "type": "string", "minLength": 10 },
        "group_dynamics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "leader_training": {
          "type": "object",
          "required": ["topic", "content"],
          "additionalProperties": false,
          "properties": {
            "topic": { "type": "string", "minLength": 5 },
            "content": { "type": "string", "minLength": 10 }
          }
        },
        "materials_needed": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["language", "editorial_status", "created_by"],
      "additionalProperties": false,
      "properties": {
        "language": { "type": "string", "minLength": 2, "maxLength": 5 },
        "editorial_status": {
          "type": "string",
          "enum": ["draft", "reviewed", "published"]
        },
        "created_by": {
          "type": "string",
          "enum": ["ai_generated", "human_edited"]
        }
      }
    }
  }
}
